# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/

# 강의자료 — 배포용 바이너리·압축본은 제외 (기획서·샘플 소스는 커밋)
강의자료/**/*.zip
강의자료/**/*.exe
강의자료/**/*.Zip


# 강의 산출물 (공개 리포에 미포함)
/Claude outputs/

# 실습서 암호 없는 원본·비밀번호 메모 (저장소 금지 — Claude outputs/ 에만 보관)
강의자료/*.html
강의자료/*비번*.txt

# 개인 강의 자료 (공개 리포에 미포함)
/개인강의/
# wrangler 로컬 캐시
.wrangler/

# dev server log
dev.log
serve.log
