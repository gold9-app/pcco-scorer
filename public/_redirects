# Cloudflare Pages routing rules
# 200 = rewrite (URL stays, content is swapped)
# workbook: /workbook/{slug} -> public/workbooks/{slug}.html
# NOTE: do NOT append .html to the target - Pages' extension-stripping rule turns it into a 308.
#       Without the extension Pages resolves workbooks/{slug}.html by itself.
/workbook/:slug  /workbooks/:slug  200
